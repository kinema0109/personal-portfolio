node_modules
dist
artifacts/
*.local
*.log
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea

# Album source PNGs: the site serves the WebP set exported by scripts/export-album-webp.mjs
public/gallery/*.png

# Generated HD sprite sources: scripts/coarsen-references.mjs redraws them on the room's pixel
# grid, and only those small *-px.png files are served, so the big originals stay local.
public/art/derived/*-coarse.png
public/art/derived/*-v2.png
public/art/derived/*-v3.png
public/art/derived/master-ball.png

# The CV PDF stays local: it carries personal contact details, and the room checks for the file
# at runtime, so without it the CV panel shows "CV not added yet" instead of a broken link.
public/cv/*.pdf
